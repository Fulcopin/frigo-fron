/* ============================================
   CONTENEDOR PRINCIPAL
   ============================================ */
.form-header {
  position: relative; /* FUNDAMENTAL: Para que el botón flote relativo a esto */
  background: white;
  margin-bottom: 1rem;
  border: 3px solid #000;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
