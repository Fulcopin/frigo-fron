          >
            <option value="">Todas las Plantillas</option>
            {uniqueTemplates.map(template => (
              <option key={template.id} value={template.id}>{template.name}</option>
            ))}
          </select>
        </div>

        <div className="actions">
          <button
            onClick={handleSelectAll}
