    }
  }, [apiCatalogData]);

  // 1. CARGAR PLANTILLAS
  useEffect(() => {
    const fetchTemplates = async () => {
      try {
        const response = await fetch(API_URL_TEMPLATES);
        if (!response.ok) throw new Error('No se pudo cargar la lista de plantillas');
        let data = await response.json();
