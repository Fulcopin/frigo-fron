  // 🎯 NUEVO: Auto-seleccionar plantilla si viene desde Home
  useEffect(() => {
    if (preSelectedTemplateId && templates.length > 0 && !selectedTemplate && !id) {
      console.log('🎯 Auto-seleccionando plantilla desde Home:', preSelectedTemplateId);
