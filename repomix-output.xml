  scroll-padding: 0 !important;
  scroll-snap-align: none !important;
}

/* 🗑️ Botón eliminar fila - alternativo (si existe duplicado) */
.btn-remove-row-alt {
  background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
