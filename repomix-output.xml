<file path="src/components/MultiBatchInput.css">
/* ===========================
   MULTI-BATCH INPUT - Estilos
   =========================== */

.multi-batch-container {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 20px;
}

.multi-batch-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.multi-batch-label {
  font-size: 14px;
  font-weight: 600;
  color: #374151;
  display: flex;
  align-items: center;
  gap: 4px;
}

.required-mark {
  color: #ef4444;
  font-size: 16px;
}

.batch-counter {
  font-size: 12px;
  color: #6b7280;
  background: #f3f4f6;
  padding: 4px 10px;
  border-radius: 12px;
  font-weight: 500;
}

/* ===========================
   INPUT AREA
   =========================== */

.multi-batch-input-area {
  display: flex;
  gap: 8px;
  align-items: flex-start;
}

.batch-chips-container {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 12px;
  background: white;
  border: 2px solid #d1d5db;
  border-radius: 8px;
  min-height: 54px;
  transition: all 0.2s ease;
}

.batch-chips-container:hover:not(.disabled) {
  border-color: #6b7280;
}

.batch-chips-container:focus-within {
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

/* ===========================
   BATCH CHIPS
   =========================== */

.batch-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  background: #f3f4f6;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  transition: all 0.2s ease;
  animation: chipSlideIn 0.2s ease;
}

@keyframes chipSlideIn {
  from {
    opacity: 0;
    transform: scale(0.8);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.batch-chip.focused {
  background: #e5e7eb;
  transform: scale(1.05);
}

/* Estados de validación */
.batch-chip.batch-status-valid {
  background: #d1fae5;
  border-color: #6ee7b7;
  color: #065f46;
}

.batch-chip.batch-status-invalid {
  background: #fee2e2;
  border-color: #fca5a5;
  color: #991b1b;
}

.batch-chip.batch-status-notfound {
  background: #fef3c7;
  border-color: #fcd34d;
  color: #92400e;
}

.batch-chip.batch-status-validating {
  background: #e0f2fe;
  border-color: #7dd3fc;
  color: #075985;
  animation: pulseValidating 1.5s ease-in-out infinite;
}

@keyframes pulseValidating {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.batch-chip.batch-status-unknown {
  background: #f3f4f6;
  border-color: #d1d5db;
  color: #374151;
}

.batch-status-icon {
