```javascript
const [isDraft, setIsDraft] = useState(false);

// Activar modo borrador
const handleSaveAsDraft = () => {
  setIsDraft(true);
  setTimeout(() => handleSaveTemplate(), 100);
};

// Al guardar exitosamente, resetear si es publicación
