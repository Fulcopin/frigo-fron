```javascript
const getUserAssignedRole = (form) => {
  if (!form.firmasData) return '';
  
  for (const [puesto, info] of Object.entries(form.firmasData)) {
    if (info.email?.toLowerCase() === currentUser.email?.toLowerCase()) {
