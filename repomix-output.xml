      {showDeleteConfirm && (
        <div className="signature-modal" onClick={cancelRemoveFirma}>
          <div className="signature-modal-content" onClick={(e) => e.stopPropagation()} style={{ maxWidth: '350px', textAlign: 'center' }}>
