                <strong>OPERADOR:</strong> toperador / Toperador26**
            </div>
            
            <h3 style="margin-top: 20px;">❌ Credenciales Eliminadas</h3>
            <div class="credential-item invalid">
                <strong>ADMIN:</strong> admin / fishcort2025
            </div>
            <div class="credential-item invalid">
                <strong>SUPERVISOR:</strong> supervisor / fishcort2025
            </div>
            <div class="credential-item invalid">
                <strong>TRABAJADOR:</strong> trabajador / fishcort2025
            </div>
        </div>
    </div>
    
    <script>
        function limpiarSesion() {
            const status = document.getElementById('status');
            
            try {
                // Eliminar todas las claves relacionadas
                localStorage.removeItem('fishcort_user');
                localStorage.removeItem('fishcort_token');
                localStorage.removeItem('fishcort_token_expiration');
                
                status.className = 'status success';
                status.innerHTML = `
                    <h3>✅ ¡Sesión limpiada exitosamente!</h3>
                    <p>Se eliminaron las siguientes claves:</p>
                    <ul>
