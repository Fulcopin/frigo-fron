            Write-Host "   Ejecuta manualmente el script SQL en:" -ForegroundColor Gray
            Write-Host "   backend-frigo\Migrations\AgregarCampoFechaTemplate.sql" -ForegroundColor White
        }
    }
    $Reader3.Close()
    
