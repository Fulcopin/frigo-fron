    Write-Host ""
    Write-Host "Credenciales para probar:" -ForegroundColor Cyan
    Write-Host "  ADMIN: admin / fishcort2025" -ForegroundColor White
    Write-Host "  SUPERVISOR: supervisor / fishcort2025" -ForegroundColor White
