    // Si hay error, mostrar línea tradicional
    doc.line(xPos, localY, xPos + firmaLineWidth, localY);
    doc.text('Firma', xPos + ..., localY + 3.5);
  }
} else {
  // 📝 Línea de firma tradicional si no hay imagen
  doc.line(xPos, localY, xPos + firmaLineWidth, localY);
