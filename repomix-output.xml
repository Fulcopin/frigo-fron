/* Indicador visual cuando se está guardando */
@keyframes saving-pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.7;
    transform: scale(0.98);
  }
}

.form-document.saving {
  animation: saving-pulse 1s ease-in-out;
}

/* Mejorar feedback táctil */
@media (hover: none) and (pointer: coarse) {
  button:active,
  .template-card:active,
  .accordion-header:active {
    transform: scale(0.97);
    transition: transform 0.1s;
  }

  /* ⚡ ELIMINADO: transform que causaba scroll/reflow */
  /* Ya no se aplica transform en inputs al hacer focus */
}

/* Reducir animaciones en dispositivos que lo prefieran */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

