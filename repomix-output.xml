            <div class="credential-item invalid">
                <strong>ADMIN:</strong> admin / fishcort2025
            </div>
            <div class="credential-item invalid">
                <strong>SUPERVISOR:</strong> supervisor / fishcort2025
            </div>
            <div class="credential-item invalid">
                <strong>TRABAJADOR:</strong> trabajador / fishcort2025
            </div>
        </div>
    </div>
    
    <script>
        function limpiarSesion() {
            const status = document.getElementById('status');
            
            try {
                // Eliminar todas las claves relacionadas
                localStorage.removeItem('fishcort_user');
                localStorage.removeItem('fishcort_token');
                localStorage.removeItem('fishcort_token_expiration');
                
                status.className = 'status success';
                status.innerHTML = `
                    <h3>✅ ¡Sesión limpiada exitosamente!</h3>
                    <p>Se eliminaron las siguientes claves:</p>
                    <ul>
                        <li>fishcort_user</li>
                        <li>fishcort_token</li>
                        <li>fishcort_token_expiration</li>
                    </ul>
                    <p style="margin-top: 15px;">
                        <strong>Próximos pasos:</strong><br>
                        1. Cierra esta ventana<br>
                        2. Ve a http://localhost:5173<br>
                        3. Deberías ver la pantalla de login<br>
                        4. Intenta con: <strong>tadmin / Tadmin26*</strong>
                    </p>
                `;
                
                console.log('✅ Sesión limpiada correctamente');
                
            } catch (error) {
                status.className = 'status error';
                status.innerHTML = `
                    <h3>❌ Error al limpiar sesión</h3>
                    <p>${error.message}</p>
                `;
            }
        }
        
        function verificarSesion() {
            const status = document.getElementById('status');
            
            const user = localStorage.getItem('fishcort_user');
            const token = localStorage.getItem('fishcort_token');
            const expiration = localStorage.getItem('fishcort_token_expiration');
            
            if (!user && !token && !expiration) {
                status.className = 'status success';
                status.innerHTML = `
                    <h3>✅ No hay sesión guardada</h3>
                    <p>El localStorage está limpio. Puedes proceder al login.</p>
                `;
            } else {
                let userObj = null;
                try {
                    userObj = JSON.parse(user);
                } catch (e) {
                    console.error('Error al parsear usuario:', e);
                }
                
                status.className = 'status error';
                status.innerHTML = `
                    <h3>⚠️ Sesión encontrada</h3>
                    <p><strong>Usuario:</strong> ${userObj?.username || 'N/A'}</p>
                    <p><strong>Rol:</strong> ${userObj?.rol || 'N/A'}</p>
                    <p><strong>Nombre:</strong> ${userObj?.nombre || 'N/A'}</p>
                    <p style="margin-top: 15px;">
                        Esta es una sesión <strong>${userObj?.username?.includes('admin') || userObj?.username?.includes('supervisor') || userObj?.username?.includes('trabajador') ? 'ANTIGUA (demo)' : 'ACTUAL (API)'}</strong>.
                    </p>
                    ${userObj?.username?.includes('admin') || userObj?.username?.includes('supervisor') || userObj?.username?.includes('trabajador') ? 
                        '<p style="color: #dc3545; font-weight: 600;">🗑️ Debes limpiarla usando el botón de arriba.</p>' : 
                        '<p style="color: #28a745; font-weight: 600;">✅ Esta sesión es válida (de la API).</p>'
                    }
                `;
            }
        }
        
        // Verificar automáticamente al cargar
        window.onload = function() {
            verificarSesion();
        };
    </script>
</body>
</html>
</file>

