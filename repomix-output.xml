        setUploading(false);
        return;
      }

      console.log(`✅ Cargando firma guardada de: ${currentUser.nombre || currentUser.username}`);

      // 3. Convertir Base64 a File para subir a Cloudinary
      const response = await fetch(savedSignature);
      const blob = await response.blob();
      const file = new File(
