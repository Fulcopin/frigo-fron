/* ========================================
   🧪 UTILIDADES PARA TESTING RESPONSIVE
   ======================================== */

/* 
   Agregar esta clase a un elemento para VER qué breakpoint está activo:
   
   <div class="show-breakpoint">
     Contenido...
   </div>
   
   En la consola verá: "Mobile", "Tablet", "Desktop"
*/

.show-breakpoint {
  position: fixed;
  bottom: 20px;
  left: 20px;
  background: #035b8d;
  color: white;
  padding: 10px 20px;
  border-radius: 6px;
  font-weight: bold;
  z-index: 800;  /* ⬇️ Bajo: solo para debugging */
  font-size: 12px;
  font-family: monospace;
}

/* Mostrar "Mobile" en móvil */
@media (max-width: 480px) {
  .show-breakpoint::before {
    content: "📱 Mobile";
  }
}

/* Mostrar "Tablet" en tablet */
@media (min-width: 481px) and (max-width: 1024px) {
  .show-breakpoint::before {
    content: "🖱️ Tablet";
  }
}

/* Mostrar "Desktop" en desktop */
@media (min-width: 1025px) {
  .show-breakpoint::before {
    content: "🖥️ Desktop";
  }
}

/* ========================================
   🎨 OVERLAY DE CONTRASTE CHECKER
   ======================================== */

/* 
   Para verificar contraste, agregar data-contrast a cualquier elemento:
   
   <p data-contrast="check">Texto para verificar</p>
*/

[data-contrast="check"] {
  background: rgba(0, 0, 0, 0.1);
  box-shadow: inset 0 0 0 2px rgba(220, 38, 38, 0.3);
  padding: 4px;
  border-radius: 2px;
}

