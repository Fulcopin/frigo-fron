}

.form-header-content {
  display: flex;
  align-items: stretch; /* Mantiene las líneas divisorias de arriba a abajo */
  min-height: 150px; /* Un poco más de aire */
}

/* ============================================
   SECCIÓN IZQUIERDA: LOGO (CENTRADO TOTAL)
