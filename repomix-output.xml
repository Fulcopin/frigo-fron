<file path="src/components/MultiBatchInput.css">
/* ===========================
   MULTI-BATCH INPUT - Estilos
   =========================== */

.multi-batch-container {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 20px;
}

.multi-batch-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.multi-batch-label {
  font-size: 14px;
  font-weight: 600;
  color: #374151;
  display: flex;
  align-items: center;
  gap: 4px;
}

.required-mark {
  color: #ef4444;
  font-size: 16px;
}

.batch-counter {
  font-size: 12px;
  color: #6b7280;
  background: #f3f4f6;
  padding: 4px 10px;
  border-radius: 12px;
  font-weight: 500;
}

/* ===========================
   INPUT AREA
   =========================== */

.multi-batch-input-area {
  display: flex;
  gap: 8px;
  align-items: flex-start;
}

.batch-chips-container {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 12px;
  background: white;
  border: 2px solid #d1d5db;
  border-radius: 8px;
  min-height: 54px;
  transition: all 0.2s ease;
}

.batch-chips-container:hover:not(.disabled) {
  border-color: #9ca3af;
}

.batch-chips-container:focus-within {
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

/* ===========================
   BATCH CHIPS
   =========================== */

.batch-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  background: #f3f4f6;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  transition: all 0.2s ease;
  animation: chipSlideIn 0.2s ease;
}

@keyframes chipSlideIn {
  from {
    opacity: 0;
    transform: scale(0.8);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.batch-chip.focused {
  background: #e5e7eb;
  transform: scale(1.05);
}

/* Estados de validación */
.batch-chip.batch-status-valid {
  background: #d1fae5;
  border-color: #6ee7b7;
  color: #065f46;
}

.batch-chip.batch-status-invalid {
  background: #fee2e2;
  border-color: #fca5a5;
  color: #991b1b;
}

.batch-chip.batch-status-notfound {
  background: #fef3c7;
  border-color: #fcd34d;
  color: #92400e;
}

.batch-chip.batch-status-validating {
  background: #e0f2fe;
  border-color: #7dd3fc;
  color: #075985;
  animation: pulseValidating 1.5s ease-in-out infinite;
}

@keyframes pulseValidating {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.batch-chip.batch-status-unknown {
  background: #f3f4f6;
  border-color: #d1d5db;
  color: #374151;
}

.batch-status-icon {
  font-size: 12px;
  display: inline-flex;
  align-items: center;
}

.batch-text {
  font-family: 'Courier New', monospace;
  font-weight: 600;
}

.batch-remove {
  background: none;
  border: none;
  color: #9ca3af;
  font-size: 18px;
  cursor: pointer;
  padding: 0;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  transition: all 0.2s ease;
}

.batch-remove:hover {
  background: rgba(0, 0, 0, 0.1);
  color: #ef4444;
}

/* ===========================
   BATCH INPUT (INLINE)
   =========================== */

.batch-input {
  flex: 1;
  min-width: 150px;
  padding: 6px 8px;
  border: none;
  outline: none;
  font-size: 13px;
  font-family: 'Courier New', monospace;
  background: transparent;
  color: #1f2937;
  font-weight: 500;
}

.batch-input::placeholder {
  color: #9ca3af;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  font-weight: 400;
}

/* ===========================
   CLEAR ALL BUTTON
   =========================== */

.clear-all-button {
  padding: 12px;
  background: #fef2f2;
  border: 1px solid #fecaca;
  border-radius: 6px;
  cursor: pointer;
  font-size: 16px;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.clear-all-button:hover {
  background: #fee2e2;
  border-color: #fca5a5;
  transform: scale(1.05);
}

/* ===========================
   HINTS
   =========================== */

.multi-batch-hints {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.hint-item {
  font-size: 12px;
  color: #6b7280;
  display: flex;
  align-items: center;
  gap: 6px;
}

.hint-item kbd {
  background: #f3f4f6;
  border: 1px solid #d1d5db;
  border-radius: 4px;
  padding: 2px 6px;
  font-size: 11px;
  font-family: monospace;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
}

/* ===========================
   DISABLED STATE
   =========================== */

.multi-batch-container.disabled {
  opacity: 0.6;
  pointer-events: none;
}

/* ===========================
   BATCH LIST DISPLAY (READ-ONLY)
   =========================== */

.batch-list-empty {
  color: #9ca3af;
  font-style: italic;
  font-size: 14px;
}

.batch-list-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.batch-chip-display {
  display: inline-block;
  padding: 6px 12px;
  background: #eff6ff;
  border: 1px solid #bfdbfe;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  color: #1e40af;
  font-family: 'Courier New', monospace;
}

.batch-list-ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.batch-list-ul li {
  padding: 6px 12px;
  background: #f9fafb;
  border-left: 3px solid #3b82f6;
  border-radius: 4px;
  font-size: 13px;
  font-family: 'Courier New', monospace;
  font-weight: 500;
}

.batch-list-inline {
  font-size: 14px;
  color: #374151;
  font-family: 'Courier New', monospace;
}

/* ===========================
   BATCH STATS
   =========================== */

.batch-stats {
  background: white;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  padding: 20px;
}

.batch-stats h3 {
  margin: 0 0 16px 0;
  font-size: 18px;
  color: #1f2937;
}

.batch-stats h4 {
  margin: 16px 0 12px 0;
  font-size: 14px;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 16px;
  margin-bottom: 20px;
}

.stat-card {
  background: linear-gradient(135deg, #f3f4f6, #e5e7eb);
  border-radius: 8px;
  padding: 16px;
  text-align: center;
}

.stat-value {
  font-size: 32px;
  font-weight: 700;
  color: #3b82f6;
  margin-bottom: 4px;
}

.stat-label {
  font-size: 12px;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.top-batches {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.batch-usage-item {
  display: grid;
  grid-template-columns: 120px 1fr 80px;
  align-items: center;
  gap: 12px;
}

.batch-name {
  font-family: 'Courier New', monospace;
  font-weight: 600;
  font-size: 13px;
  color: #1f2937;
}

.usage-bar {
