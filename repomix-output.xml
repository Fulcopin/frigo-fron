                                        </tr>
                                    </table>
                                    
                                    <div style='margin: 30px 0; text-align: center;'>
                                        <a href='http://localhost:5173/signatures' 
                                           style='background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); 
                                                  color: white; 
