  gap: 0.75rem;
  font-size: 0.95rem;
}

.date-icon {
  font-size: 1.2rem;
}

.date-label {
  color: #6b7280;
  font-weight: 600;
}

.date-value {
  color: #1f2937;
  font-weight: 500;
}

.version-actions {
  display: flex;
  gap: 0.75rem;
  margin-top: 1.25rem;
}

.btn-select {
  flex: 1;
  padding: 0.75rem 1rem;
  border: 2px solid #e5e7eb;
  background: white;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  font-size: 0.9rem;
  transition: all 0.3s;
}

.btn-select:hover {
  border-color: #667eea;
  background: #f3f4f6;
  transform: translateY(-2px);
}

.btn-select.selected.old {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-color: #f59e0b;
  color: #78350f;
  font-weight: 700;
}

.btn-select.selected.new {
  background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
