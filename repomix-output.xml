                }
                html += "</div></div>";
            }

            html += @"
        </div>
        <div class='footer'>
            <p>Este correo fue enviado desde el Sistema de Gestion de Frigolab</p>
            <p> Enviado automaticamente - No responder a este correo</p>
        </div>
    </div>
</body>
</html>";

            return html;
        }
    }
}
