    padding: 10px 16px;
    font-size: 15px;
    min-height: 44px;
  }

  /* ============================================
     📊 GRID LAYOUTS ADAPTATIVOS
     ============================================ */
  
  /* Grid de 2 columnas en portrait, 3 en landscape */
  .header-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .signatures-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  /* ============================================
     🎨 INDICADORES Y FEEDBACK VISUAL
     ============================================ */
  
  /* Indicador de autoguardado menos invasivo */
  .autosave-indicator {
    top: auto;
    bottom: 20px;
    right: 20px;
    padding: 12px 18px;
    font-size: 14px;
    border-radius: 10px;
    max-width: 250px;
  }

  /* Badges más pequeños */
  .badge-lotes,
  .badge-manual {
    padding: 6px 12px;
    font-size: 13px;
    border-radius: 6px;
  }

  /* ============================================
     📱 PREVENCIÓN DE PROBLEMAS TÁCTILES
     ============================================ */
  
  /* Evitar selección de texto accidental */
  .accordion-header,
  .table-header,
  button,
  .lote-item {
    -webkit-user-select: none;
    user-select: none;
  }

  /* Permitir selección en inputs y editables */
  input,
  textarea,
  .data-table td {
    -webkit-user-select: text;
    user-select: text;
  }

  /* Scroll más visible */
  ::-webkit-scrollbar {
    width: 12px;
    height: 12px;
  }

  ::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
    border-radius: 10px;
    border: 2px solid #f1f5f9;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
  }

  /* ============================================
     🌐 ORIENTACIÓN LANDSCAPE
     ============================================ */
  
  @media (orientation: landscape) {
    /* Encabezado aún más compacto en landscape */
    .form-header.expanded .form-header-content {
      max-height: 200px;
    }

    /* Grid de 3 columnas */
    .header-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    /* Tabla con menos altura */
    .table-wrapper {
      max-height: 350px;
    }

    /* Botones en fila */
    .form-actions-bottom {
      flex-direction: row;
      justify-content: center;
    }
  }

  /* ============================================
     🎯 MEJORAS DE PRECISIÓN
     ============================================ */
  
  /* Separación visual entre secciones */
  .form-section {
    margin-bottom: 1.5rem;
    padding: 1.25rem;
    border-radius: 12px;
  }

  /* Etiquetas más legibles */
  label {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 8px;
    display: block;
    color: #374151;
  }

  /* Mensajes de error/validación más visibles */
  .error-message,
  .validation-message {
    font-size: 14px;
    padding: 10px 14px;
    margin-top: 8px;
    border-radius: 8px;
  }

  /* ============================================
     ⚡ OPTIMIZACIÓN DE RENDIMIENTO
     ============================================ */
  
  /* Hardware acceleration para animaciones */
  button,
  .accordion-header,
  .template-card,
  .lote-item {
    transform: translateZ(0);
    will-change: transform;
  }

  /* Reducir complejidad visual en movimiento */
  * {
    transition-duration: 200ms !important;
  }

  /* ============================================
     🎨 ESTADOS INTERACTIVOS MEJORADOS
     ============================================ */
  
  /* Feedback visual al tocar */
  button:active,
  .accordion-header:active,
  .template-card:active,
  .lote-item:active {
    transform: scale(0.98) translateZ(0);
    opacity: 0.9;
  }

  /* Focus más visible */
  input:focus,
  select:focus,
  textarea:focus,
  button:focus {
    outline: 3px solid rgba(37, 99, 235, 0.5);
    outline-offset: 2px;
  }

  /* ============================================
     📐 AJUSTES ESPECÍFICOS DE LAYOUT
     ============================================ */
  
  /* Reducir padding del contenedor principal */
  .form-document {
    padding: 1rem;
    border-radius: 10px;
  }

  /* Headers de sección menos prominentes */
  .section-header h3 {
    font-size: 1.1rem;
    padding: 10px 0;
  }

  /* Tarjetas de plantilla adaptadas */
  .template-card {
    padding: 1.25rem;
    border-radius: 10px;
  }

  .templates-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
}

/* ============================================
   🎯 TABLET PORTRAIT ESPECÍFICO (768px-1024px)
   ============================================ */
@media (min-width: 768px) and (max-width: 1024px) and (orientation: portrait) {
  
  /* Layout de una columna para mejor legibilidad */
  .header-grid,
  .signatures-grid {
    grid-template-columns: 1fr !important;
  }

  /* Tabla con más altura disponible */
  .table-wrapper {
    max-height: 600px;
  }

  /* Botones apilados verticalmente */
  .form-actions-bottom {
    flex-direction: column;
  }

  .form-actions-bottom button {
    width: 100%;
  }
}

/* ============================================
   🎯 TABLET LANDSCAPE ESPECÍFICO
   ============================================ */
@media (min-width: 768px) and (max-width: 1024px) and (orientation: landscape) {
  
  /* Aprovechar ancho horizontal */
  .templates-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  /* Formulario en dos columnas */
  .form-grid-2col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
}

/* ============================================
   ⚡ OPTIMIZACIONES DE RENDIMIENTO
   ============================================ */

/* Reducir animaciones en tablets para mejor performance */
@media (min-width: 768px) and (max-width: 1024px) {
  @media (prefers-reduced-motion: no-preference) {
    * {
      transition-duration: 150ms !important;
    }
  }
}

/* ============================================
   🎨 MEJORAS VISUALES FINALES
   ============================================ */
@media (min-width: 768px) and (max-width: 1024px) {
  
  /* Sombras más sutiles */
  .form-document,
  .table-wrapper,
  .form-section {
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  }

  /* Bordes redondeados consistentes */
  .form-section,
  .table-wrapper,
  .accordion-section,
  button,
  input,
  select,
  textarea {
    border-radius: 10px;
  }

  /* Espaciado vertical consistente */
  .form-section + .form-section {
    margin-top: 1.25rem;
  }
