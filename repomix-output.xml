  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.75rem 1.5rem;
  background: #f8f9fa;
  color: #495057;
  border: 2px solid #dee2e6;
  border-radius: 8px;
  font-size: 1rem;
