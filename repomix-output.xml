/* ============================================
   ESTILOS PARA ACORDEÓN (SECCIONES COLAPSABLES)
   Optimizado para tablets de 10 pulgadas
   ============================================ */
.accordion-section {
  margin-bottom: 0.75rem;
  border: 1px solid #e1e1e1;
  border-radius: 0;
  overflow: hidden;
  background: white;
  transition: none;
  scroll-margin: 0 !important;
  scroll-padding: 0 !important;
  overscroll-behavior: none !important;
}

.accordion-section.collapsed {
  box-shadow: none;
}

.accordion-section.expanded {
  box-shadow: none;
  border-color: #e1e1e1;
}

.accordion-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem 1rem;
  background: #035b8d;
  cursor: pointer;
  user-select: none;
  transition: none;
  border-bottom: none;
  gap: 0.75rem;
}

.accordion-section.expanded .accordion-header {
  background: #035b8d;
  border-bottom: none;
}

.accordion-section.expanded .accordion-header .accordion-title,
.accordion-section.expanded .accordion-header .accordion-toggle {
  color: white;
}

.accordion-section.expanded .accordion-header .accordion-icon {
  color: white;
}

.accordion-header:hover {
  background: #024a73;
}

.accordion-section.expanded .accordion-header:hover {
  background: #024a73;
}

.accordion-header:active {
  transform: none;
}

.accordion-title {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 1rem;
  font-weight: 600;
  color: white;
  margin: 0;
  flex: 1;
  min-width: 0;
}

.accordion-title-text {
  flex: 1;
  min-width: 0; /* Permite truncamiento si es necesario */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.accordion-icon {
  font-size: 1.125rem;
  color: white;
  transition: none;
  flex-shrink: 0;
}

.accordion-section.expanded .accordion-icon {
  transform: none;
}

.accordion-badge {
  display: inline-block;
  background: white;
  color: #035b8d;
  font-size: 0.75rem;
  padding: 0.25rem 0.625rem;
  border-radius: 12px;
  font-weight: 600;
  margin-left: 0.5rem;
  white-space: nowrap;
  flex-shrink: 0;
}

.accordion-section.expanded .accordion-badge {
  background: white;
  color: #035b8d;
}

.accordion-toggle {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.75rem;
  color: white;
  font-weight: 500;
  flex-shrink: 0;
  padding: 0.4rem 0.7rem;
  background: white;
  border: 1px solid white;
  border-radius: 3px;
  transition: background 0.2s;
  cursor: pointer;
  white-space: nowrap;
  color: #035b8d;
}

.accordion-toggle:hover {
  background: #f5f5f5;
}

.accordion-toggle:active {
  transform: none;
}

.accordion-section.expanded .accordion-toggle {
  background: white;
  border-color: white;
  color: #035b8d;
}

.accordion-section.expanded .accordion-toggle:hover {
  background: #f5f5f5;
}

.toggle-text {
  display: inline-block;
  line-height: 1;
}

.toggle-icon {
  font-size: 0.875rem; /* Más pequeño, reducido de 1rem */
  transition: transform 0.3s ease;
  font-weight: bold;
  line-height: 1; /* Alineación vertical */
  display: inline-block;
}

.accordion-section.expanded .toggle-icon {
  transform: rotate(180deg);
}

.accordion-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s ease, padding 0.3s ease;
  /* ⚡ PREVENCIÓN DE SCROLL AUTOMÁTICO */
  scroll-margin: 0 !important;
  scroll-padding: 0 !important;
  overscroll-behavior: none !important;
  contain: layout style paint !important;
}

.accordion-section.expanded .accordion-content {
  max-height: 10000px;
  padding: 1rem;
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ============================================
   RESPONSIVE - TABLET 10 PULGADAS (768px - 1024px)
   Optimizado para UROVO P8100 4G
   ============================================ */
@media (max-width: 1024px) and (min-width: 768px) {
  .accordion-header {
    padding: 0.875rem 1.25rem;
    gap: 0.875rem;
  }

  .accordion-title {
    font-size: 1rem;
    gap: 0.625rem;
  }

  .accordion-icon {
    font-size: 1.125rem;
  }

  .accordion-badge {
    font-size: 0.6875rem;
    padding: 0.15rem 0.4rem;
  }

  .accordion-toggle {
    font-size: 0.6875rem;
    padding: 0.35rem 0.6rem;
    gap: 0.25rem;
  }

  .toggle-icon {
    font-size: 0.8125rem;
  }

  .accordion-section.expanded .accordion-content {
    padding: 1.25rem;
  }
}

/* ============================================
   RESPONSIVE - MÓVIL (< 768px)
   ============================================ */
@media (max-width: 768px) {
  .accordion-section {
    margin-bottom: 1rem;
    border-radius: 8px;
  }

  .accordion-header {
    padding: 0.875rem 1rem;
    gap: 0.75rem;
  }

  .accordion-title {
    font-size: 0.9375rem;
    gap: 0.5rem;
  }

  .accordion-icon {
    font-size: 1.125rem;
  }

  .accordion-badge {
    font-size: 0.6875rem;
    padding: 0.15rem 0.4rem;
  }

  .accordion-toggle {
    font-size: 0.6875rem;
    padding: 0.35rem 0.6rem;
    gap: 0.25rem;
  }

  .toggle-icon {
    font-size: 0.8125rem;
  }

  .accordion-section.expanded .accordion-content {
    padding: 1rem;
  }
}

/* ============================================
   MODO OSCURO (opcional)
   ============================================ */
@media (prefers-color-scheme: dark) {
  .accordion-section {
    border-color: rgba(255, 255, 255, 0.1);
  }

  .accordion-header {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
  }

  .accordion-section.expanded {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }
}

/* Accesibilidad */
.accordion-header:focus {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  .accordion-content,
  .toggle-icon,
  .accordion-icon {
    transition: none;
  }
  
  .accordion-section.expanded .accordion-content {
    animation: none;
  }
}
