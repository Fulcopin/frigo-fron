  const newLines = [
    ...lines.slice(0, startLine),
    '',
    ...lines.slice(endLine)
  ];
  fs.writeFileSync(f, newLines.join('\n'), 'utf8');
  console.log('SUCCESS: Removed lines', startLine + 1, 'to', endLine, '(' + (endLine - startLine) + ' lines)');
