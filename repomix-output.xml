  display: flex;
  align-items: center;
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.btn-back {
  background: #e2e8f0;
  color: #475569;
  padding: 0.75rem 1.25rem;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-back:hover {
  background: #cbd5e1;
}

.data-header h1 {
  font-size: 2rem;
  color: #1e40af;
  margin-bottom: 0.5rem;
}

.data-header p {
  color: #64748b;
  margin: 0;
}

.data-controls {
  display: flex;
