            disabled={filteredForms.length === 0}
          >
            {selectedForms.length === filteredForms.length ? '☑️ Deseleccionar Todo' : '☐ Seleccionar Todo'}
          </button>
          
          <button
            onClick={() => openSignatureModal(true)}
