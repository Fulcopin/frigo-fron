    const link = document.createElement('a');
    link.href = firmaUrl;
    link.download = `firma_${puesto.replace(/\s+/g, '_')}.png`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    
    console.log('⬇️ Firma descargada:', puesto);
  };

