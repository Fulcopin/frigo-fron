}

/* Botón outline primario */
/* ================================================
   BOTONES CON VISIBILIDAD MEJORADA
   ================================================ */

/* Botón primario outline */
.btn-outline-primary {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
