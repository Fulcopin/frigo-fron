                  {contractFormData.headerData && typeof contractFormData.headerData === 'object' && Object.keys(contractFormData.headerData).length > 0 && (
                    <div style={{
                      background: 'white',
                      borderRadius: '12px',
                      padding: '1.2rem',
                      marginBottom: '1rem',
