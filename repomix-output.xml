.version-icon {
  font-size: 1.1rem;
  line-height: 1;
}

.version-text {
  font-size: 0.875rem;
}

/* ============================================
   RESPONSIVE PARA TABLETS
   ============================================ */
@media (max-width: 1024px) {
  .version-badge {
    padding: 1rem 1.25rem;
  }

  .badge-title {
    font-size: 1rem;
  }

  .badge-message {
    font-size: 0.9rem;
    padding: 0.75rem;
  }

  .badge-footer {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .inline-version-badge {
    margin-left: 0;
    margin-top: 0.5rem;
    width: 100%;
    justify-content: center;
  }
}

@media (max-width: 768px) {
  .version-indicator-container {
    margin: 1rem 0;
  }

  .version-badge {
    padding: 0.875rem 1rem;
  }

  .badge-header {
    flex-wrap: wrap;
  }

  .badge-icon {
    font-size: 1.25rem;
  }

  .badge-title {
    font-size: 0.95rem;
  }

  .badge-version {
    padding: 0.3rem 0.7rem;
    font-size: 0.8rem;
  }

  .badge-message {
    font-size: 0.85rem;
    padding: 0.65rem;
  }

  .compact-version-badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
  }
}

/* ============================================
   ANIMACIONES Y ESTADOS
   ============================================ */
@keyframes pulse-version {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(251, 191, 36, 0.7);
  }
  50% {
    box-shadow: 0 0 0 6px rgba(251, 191, 36, 0);
  }
}

.version-badge.historic.pulse {
  animation: pulse-version 2s infinite;
}

/* Modo de impresión - simplificar colores */
@media print {
  .version-badge {
    border: 2px solid #000;
    background: #fff !important;
    box-shadow: none;
    break-inside: avoid;
  }

  .version-badge.historic {
    border-left: 4px solid #f59e0b;
  }

  .version-badge.current {
    border-left: 4px solid #10b981;
  }

  .badge-message {
    background: #f5f5f5 !important;
    color: #000 !important;
  }

  .badge-version {
    background: #666 !important;
    color: #fff !important;
  }
}
