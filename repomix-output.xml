                                  ))}
                                </tr>
                              </thead>
                              <tbody>
                                {tableRows.map((row, rowIndex) => (
                                  <tr key={rowIndex} style={{ background: rowIndex % 2 === 0 ? '#fff' : '#f9fafb' }}>
                                    <td style={{ padding: '6px', border: '1px solid #e5e7eb', textAlign: 'center', fontWeight: 500 }}>{rowIndex + 1}</td>
