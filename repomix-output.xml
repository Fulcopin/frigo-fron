                    </div>
                    <div style={{ display: 'flex', gap: '8px' }}>
                      <button
                        onClick={clearCanvas}
                        style={{
                          padding: '8px 16px',
                          border: '1px solid #ddd',
                          borderRadius: '6px',
                          background: '#fff',
                          cursor: 'pointer',
                          fontSize: '13px'
                        }}
                      >
                        🧹 Limpiar
                      </button>
                      <button
                        onClick={saveDrawnSignature}
                        style={{
                          padding: '8px 16px',
                          border: 'none',
                          borderRadius: '6px',
                          background: '#4caf50',
                          color: '#fff',
                          cursor: 'pointer',
                          fontSize: '13px',
                          fontWeight: 'bold'
                        }}
                      >
                        � Guardar Firma Dibujada
                      </button>
                    </div>
                  </div>
                )}

                {/* Preview de firma (cualquier método) */}
                {signatureImage && (
                  <div className="signature-preview" style={{ marginTop: '12px', textAlign: 'center' }}>
                    <p style={{ color: '#4caf50', fontWeight: 'bold', marginBottom: '8px' }}>✅ Firma lista:</p>
                    <img
                      src={signatureImage}
                      alt="Firma"
