}

.table-wrapper::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
}

/* Encabezado de tabla sticky */
.data-table thead {
  background: var(--background);
  position: sticky;
  top: 0;
  z-index: 10;
