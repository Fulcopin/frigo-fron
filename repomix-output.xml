  overflow: hidden;
  /* Fondo con imagen de containers (como en tu diseño) */
  background: linear-gradient(135deg, rgba(3, 91, 141, 0.95) 0%, rgba(3, 91, 141, 0.85) 50%, rgba(43, 43, 43, 0.90) 100%),
              url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800"><rect fill="%232b2b2b" width="1200" height="800"/></svg>');
  background-size: cover;
  background-position: center;
}

/* Animated Background */
.login-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  z-index: 0;
}

.fish-animation {
  position: relative;
  width: 100%;
  height: 100%;
}

.fish {
  position: absolute;
  font-size: 2rem;
  animation: swim 15s infinite linear;
  opacity: 0.3;
}

.fish:nth-child(1) {
  top: 20%;
  animation-duration: 12s;
  animation-delay: 0s;
}

.fish:nth-child(2) {
  top: 50%;
  animation-duration: 18s;
  animation-delay: 3s;
}

.fish:nth-child(3) {
  top: 70%;
  animation-duration: 15s;
  animation-delay: 6s;
}

@keyframes swim {
  0% {
    left: -10%;
    transform: scaleX(1);
  }
  45% {
    left: 110%;
    transform: scaleX(1);
  }
  50% {
    left: 110%;
    transform: scaleX(-1);
  }
  95% {
    left: -10%;
    transform: scaleX(-1);
  }
  100% {
    left: -10%;
