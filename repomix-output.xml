}

.section-header {
  text-align: center;
  margin-bottom: 30px;
}

.section-header h2 {
  font-size: 2rem;
  color: #2c3e50;
  margin-bottom: 10px;
}

.section-header p {
  color: #7f8c8d;
  font-size: 1rem;
}

.signature-date {
  color: #95a5a6;
  font-size: 0.95rem;
  margin-top: 10px;
}

/* Signature Preview */
.signature-preview {
  background: #f8f9fa;
  border: 3px solid #e9ecef;
  border-radius: 15px;
  padding: 30px;
  margin-bottom: 30px;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 200px;
