                                color: item.status === 'signed' ? '#166534' : item.status === 'rejected' ? '#991b1b' : '#92400e'
                              }}>
                                {item.status === 'signed' ? '✅ Firmado' : item.status === 'rejected' ? '❌ Rechazado' : '⏳ Pendiente'}
