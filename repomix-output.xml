  border: 1px solid #10b981;
}

/* ============================================
   BADGE INLINE (para headers de formularios)
   ============================================ */
.inline-version-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  border-radius: 6px;
  font-size: 0.9rem;
  font-weight: 600;
  margin-left: 1rem;
}

.inline-version-badge.historic {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
