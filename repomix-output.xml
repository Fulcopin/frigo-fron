              </button>
              <button 
                className="btn-email-send" 
                onClick={handleSendEmail}
                disabled={sendingEmail || !emailTo}
              >
                {sendingEmail ? '⏳ Enviando...' : '📧 Enviar Correo'}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* 🔼🔽 Botones de scroll */}
      <ScrollButton />
    </div>
  );
}

export default ViewForms;
