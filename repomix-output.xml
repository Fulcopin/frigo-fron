                if (totalColumn) {
                  // Obtener el nombre de la columna TOTAL
                  const totalKey = totalColumn.label || totalColumn.header || totalColumn.id || totalColumn.name;
                  
                  // Sumar todos los valores de las columnas PESO
                  let total = 0;
                  Object.keys(updatedRow).forEach(key => {
                    const keyUpper = key.toUpperCase();
                    if (keyUpper.includes('PESO') && !keyUpper.includes('TOTAL')) {
                      const peso = Number.parseFloat(updatedRow[key]);
                      if (!Number.isNaN(peso)) {
