/* ⚡ PREVENCIÓN DE SCROLL SIMPLE Y EFECTIVA */
*, *::before, *::after {
  scroll-margin: 0 !important;
  scroll-padding: 0 !important;
}

html {
  scroll-behavior: auto !important;
  overflow-anchor: none !important;
}

body {
  overflow-anchor: none !important;
  overscroll-behavior: none !important;
}

/* 🆕 ANIMACIÓN PARA INDICADOR DE CAMBIOS SIN GUARDAR */
@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.6;
    transform: scale(1.1);
  }
}

/* 🆕 ESTILOS PARA TABS (PESTAÑAS) */
.tabs-container {
  position: sticky;
  top: 0;
  z-index: 1000;
  animation: slideDown 0.3s ease-out;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ⚡ INPUTS EN TABLAS - FOCUS AZUL SUTIL */
.data-table input,
.data-table select, 
.data-table textarea,
.table-wrapper input,
.table-wrapper select,
.table-wrapper textarea {
