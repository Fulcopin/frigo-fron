import ExcelJS from 'exceljs';
import { saveAs } from 'file-saver';
import logoUrl from '../assets/logo.png';

/**
 * 🎨 COLORES CORPORATIVOS DE FRIGOLAB
 */
const EXCEL_COLORS = {
  primary: 'FF0066CC',       // Azul Frigolab
  secondary: 'FFE6E6E6',     // Gris claro
