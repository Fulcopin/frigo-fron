   Ver elementos que están ocultos con display: none:
   Descomentar para debugging
*/

/*
.show-hidden [style*="display: none"],
.show-hidden [style*="visibility: hidden"],
.show-hidden [style*="opacity: 0"] {
  outline: 3px dashed rgba(255, 0, 0, 0.8) !important;
