/* ===========================
   SIMPLE PRODUCTION FORM
   Estilos simplificados
   =========================== */

.simple-form-container {
  max-width: 800px;
  margin: 2rem auto;
  padding: 2rem;
  background: white;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
}

.form-header {
  text-align: center;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 2px solid #e5e7eb;
}

.form-header h1 {
  margin: 0 0 0.5rem 0;
  color: #1f2937;
  font-size: 1.8rem;
}

.form-header p {
  margin: 0;
  color: #6b7280;
  font-size: 0.95rem;
}

.conversion-note {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  border-left: 4px solid #3b82f6;
  padding: 1rem 1.5rem;
  border-radius: 8px;
  margin-bottom: 2rem;
}

.conversion-note strong {
  display: block;
  color: #1e40af;
  margin-bottom: 0.5rem;
  font-size: 1rem;
}

.conversion-note p {
  margin: 0;
  color: #1f2937;
  font-size: 0.9rem;
  line-height: 1.6;
}

.simple-form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-group label {
  font-size: 14px;
  font-weight: 600;
  color: #374151;
}

.required {
  color: #ef4444;
  font-size: 16px;
}

.form-group input,
.form-group textarea {
  padding: 12px 16px;
  font-size: 16px;
  border: 2px solid #d1d5db;
  border-radius: 8px;
  transition: all 0.2s ease;
  font-family: inherit;
}

.form-group input:focus,
.form-group textarea:focus {
