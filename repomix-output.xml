/* ============================================
   🔍 BARRA DE BÚSQUEDA
   ============================================ */

.search-bar-manage {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: white;
  border: 2px solid #e2e8f0;
  border-radius: 10px;
  padding: 0.5rem 1rem;
  margin-bottom: 1.5rem;
  transition: border-color 0.3s;
}

.search-bar-manage:focus-within {
  border-color: #667eea;
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
}

.search-icon-manage {
  font-size: 1.2rem;
  flex-shrink: 0;
}

.search-input-manage {
  flex: 1;
  border: none;
  outline: none;
  font-size: 1rem;
  padding: 0.4rem 0;
  background: transparent;
  color: #1e293b;
}

.search-input-manage::placeholder {
  color: #94a3b8;
}

.search-clear-manage {
  background: #e2e8f0;
  border: none;
  border-radius: 50%;
  width: 24px;
  height: 24px;
  cursor: pointer;
  font-size: 0.8rem;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #475569;
  transition: background 0.2s;
}

.search-clear-manage:hover {
  background: #cbd5e1;
}

.search-count-manage {
  font-size: 0.8rem;
  color: #94a3b8;
  white-space: nowrap;
}

/* ============================================
   📝 MODAL: HISTORIAL MANUAL
   ============================================ */

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1100;  /* ⬆️ ENCIMA de tabs (1050) */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-manual-history {
  background: white;
  border-radius: 12px;
  width: 100%;
  max-width: 700px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

.modal-header-mh {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid #e2e8f0;
  position: sticky;
  top: 0;
  background: white;
  z-index: 1;
  border-radius: 12px 12px 0 0;
}

.modal-header-mh h2 {
  margin: 0;
  font-size: 1.25rem;
  color: #1e293b;
}

.modal-subtitle-mh {
  margin: 2px 0 0;
  font-size: 0.85rem;
  color: #64748b;
}

.modal-close-mh {
  background: #f1f5f9;
  border: none;
  width: 32px;
  height: 32px;
  border-radius: 8px;
  font-size: 1.2rem;
  cursor: pointer;
  color: #475569;
  transition: background 0.2s;
  flex-shrink: 0;
}

.modal-close-mh:hover {
  background: #e2e8f0;
}

.mh-form {
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid #e2e8f0;
  background: #f8fafc;
}

.mh-form h3 {
  margin: 0 0 0.75rem;
  font-size: 1rem;
  color: #334155;
}

.mh-form-grid {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.mh-field label {
  display: block;
  font-size: 0.8rem;
  font-weight: 600;
  color: #475569;
  margin-bottom: 4px;
}

.mh-field input,
.mh-field textarea {
  width: 100%;
  padding: 0.5rem 0.75rem;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
  font-size: 0.9rem;
  font-family: inherit;
  resize: vertical;
}

.mh-field input:focus,
.mh-field textarea:focus {
  border-color: #667eea;
  outline: none;
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.btn-add-mh {
  margin-top: 0.75rem;
  padding: 0.5rem 1.5rem;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  font-size: 0.9rem;
  transition: all 0.3s;
}

.btn-add-mh:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
}

.mh-entries {
  padding: 1.25rem 1.5rem;
}

.mh-entries h3 {
  margin: 0 0 0.75rem;
  font-size: 1rem;
  color: #1e293b;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.mh-empty {
  text-align: center;
  color: #94a3b8;
  padding: 2rem;
  font-style: italic;
}

/* ---- Tabla de cambios ---- */
.mh-table-wrapper {
  overflow-x: auto;
}

.mh-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.88rem;
}

.mh-table thead th {
  background: #1e293b;
  color: #fff;
  padding: 0.6rem 0.75rem;
  text-align: left;
  font-weight: 700;
  font-size: 0.8rem;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  white-space: nowrap;
}

.mh-table thead th:first-child {
  border-radius: 6px 0 0 0;
}

.mh-table thead th:last-child {
  border-radius: 0 6px 0 0;
}

.mh-table tbody tr {
  border-bottom: 1px solid #e2e8f0;
  transition: background 0.15s;
}

.mh-table tbody tr:hover {
  background: #f8fafc;
}

.mh-table tbody td {
  padding: 0.6rem 0.75rem;
  vertical-align: top;
  color: #334155;
}

.mh-td-fecha {
  white-space: nowrap;
  font-weight: 500;
  min-width: 90px;
}

.mh-td-version {
  text-align: center;
  font-weight: 700;
  color: #667eea;
  min-width: 65px;
}

.mh-td-modificacion {
  line-height: 1.45;
}

.mh-td-modificacion strong {
  color: #1e293b;
}

.mh-responsable-tag {
  display: inline-block;
  margin-top: 4px;
  font-size: 0.78rem;
  color: #64748b;
}

.mh-entry-delete {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 0.9rem;
  opacity: 0.4;
  transition: opacity 0.2s;
}

.mh-entry-delete:hover {
  opacity: 1;
}

/* ============================================
   👁️ MODAL: PRE-VISUALIZACIÓN
   ============================================ */

.modal-preview {
  background: white;
  border-radius: 12px;
  width: 100%;
  max-width: 900px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  animation: slideUp 0.3s ease;
}

.modal-header-preview {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid #e2e8f0;
  position: sticky;
  top: 0;
  background: white;
  z-index: 1;
  border-radius: 12px 12px 0 0;
}

.modal-header-preview h2 {
  margin: 0;
  font-size: 1.25rem;
  color: #1e293b;
}

.preview-content {
  padding: 1.5rem;
}

.preview-info-box {
  background: #f0f4ff;
  border-left: 4px solid #667eea;
  padding: 0.75rem 1rem;
  border-radius: 0 6px 6px 0;
  font-size: 0.9rem;
  color: #334155;
  margin-bottom: 1.5rem;
}

.preview-section {
  margin-bottom: 1.5rem;
}

.preview-section h3 {
  font-size: 1rem;
  color: #1e3a5f;
  margin-bottom: 0.75rem;
  padding-bottom: 0.4rem;
  border-bottom: 2px solid #e2e8f0;
}

.preview-table {
  width: 100%;
  border-collapse: collapse;
}

.preview-table td,
.preview-table th {
  padding: 0.5rem 0.75rem;
  border: 1px solid #e2e8f0;
  font-size: 0.85rem;
}

.preview-table th {
  background: #f0f4ff;
  font-weight: 600;
  color: #1e3a5f;
  text-align: left;
  font-size: 0.8rem;
}

.preview-label {
  background: #f8fafc;
  font-weight: 600;
  color: #334155;
  width: 200px;
}

.preview-value input,
.preview-value select,
.preview-value textarea {
  width: 100%;
  padding: 4px 8px;
  border: 1px solid #cbd5e1;
  border-radius: 4px;
  font-size: 0.85rem;
  background: #fafafa;
}

.preview-table-wrapper {
  overflow-x: auto;
}

.preview-table-body td input,
.preview-table-body td select {
  padding: 3px 6px;
  border: 1px solid #e2e8f0;
  border-radius: 4px;
  font-size: 0.8rem;
  background: #fafafa;
}

.preview-firmas {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 1rem;
}

.preview-firma-box {
  text-align: center;
  min-width: 150px;
}

.preview-firma-area {
  height: 60px;
  border: 1px dashed #cbd5e1;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  font-size: 0.8rem;
  margin-bottom: 6px;
  background: #fafafa;
}

.preview-firma-puesto {
  font-weight: 700;
  font-size: 0.85rem;
  color: #1e3a5f;
}

.preview-firma-fields {
  display: flex;
  flex-direction: column;
  gap: 2px;
  font-size: 0.75rem;
  color: #64748b;
  margin-top: 4px;
}

/* ============================================
   🔃 BOTONES DE REORDENAR (en EditTemplate)
   ============================================ */

.btn-move-up,
.btn-move-down {
  background: #e2e8f0;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 0.85rem;
  padding: 2px 6px;
  transition: background 0.2s;
}

.btn-move-up:hover,
.btn-move-down:hover {
  background: #cbd5e1;
}

.btn-move-up:disabled,
.btn-move-down:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

.reorder-buttons {
  display: flex;
  gap: 4px;
  margin-left: auto;
}

/* ============================================
   📱 RESPONSIVE
   ============================================ */

@media (max-width: 768px) {
  .template-card-manage {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .template-card-actions {
    width: 100%;
    justify-content: flex-start;
  }

  .search-bar-manage {
    flex-wrap: wrap;
  }

  .modal-manual-history,
  .modal-preview {
    max-width: 100%;
    max-height: 95vh;
    border-radius: 8px;
  }
}
