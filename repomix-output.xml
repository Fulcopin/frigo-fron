    box-shadow: 0 0 0 0 rgba(251, 191, 36, 0.7);
  }
  50% {
    box-shadow: 0 0 0 6px rgba(251, 191, 36, 0);
  }
}

/* Contenedor de opción sin lote */
.no-lote-option {
  margin: 1.5rem 0;
  padding: 1rem;
  border-radius: 8px;
  background: #f9fafb;
  border: 1px dashed #d1d5db;
}

/* Mensaje informativo (azul) */
.info-message {
